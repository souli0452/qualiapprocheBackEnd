# Étape 1 : Build avec Maven et Java 21
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

# Copie du pom.xml parent et des sources
COPY . .

# Compilation spécifique du module ia-service
# -pl : project list (on cible ia-service)
# -am : also make (on compile les dépendances nécessaires comme le module common)
RUN mvn clean package -DskipTests -pl ia-service -am

# Étape 2 : Image finale légère avec le JRE 21
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# Récupération du JAR exécutable généré à l'étape précédente
COPY --from=build /app/ia-service/target/*.jar ia-service.jar

# Port d'écoute par défaut de ia-service
EXPOSE 8091

ENTRYPOINT ["java", "-jar", "ia-service.jar"]
