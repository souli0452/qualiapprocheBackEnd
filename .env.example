# Variables d'environnement des services QualiSira.
#
# Copier ce fichier en `.env` — ignoré par git — et y porter les vraies valeurs. Aucun secret ne
# doit figurer ici : ce fichier est versionné, et un mot de passe versionné est un mot de passe
# public.
#
#   cp .env.example .env

# ---------------------------------------------------------------- base de données
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL_WORKFLOW=jdbc:postgresql://localhost:5432/qualisira_workflowdb

# ---------------------------------------------------------------- Keycloak
KC_ISSUER_URI=http://localhost:8080/realms/quali
KC_CLIENT_ID=quali-sira
KC_CLIENT_SECRET=
KC_TOKEN_URI=http://localhost:8080/realms/quali/protocol/openid-connect/token

# ---------------------------------------------------------------- courriel (SMTP)
#
# Le mot de passe n'a aucune valeur par défaut dans les fichiers de configuration : un service qui
# démarre sans lui échoue avec un message explicite, au lieu de tourner en n'envoyant rien — ce qui
# est précisément ce qui s'est produit et n'a laissé aucune trace parlante.
#
# Deux façons de chiffrer, à ne jamais activer ensemble :
#   port 465 → MAIL_SSL=true  MAIL_STARTTLS=false   (SSL implicite, le défaut)
#   port 587 → MAIL_SSL=false MAIL_STARTTLS=true    (la connexion démarre en clair puis se chiffre)
MAIL_HOST=mail.qualisira.com
MAIL_PORT=465
MAIL_USERNAME=noreply@qualisira.com
MAIL_PASSWORD=
MAIL_SSL=true
MAIL_STARTTLS=false
# Délai avant d'abandonner une connexion ou un envoi, en millisecondes. Sans lui, un serveur
# injoignable retient le fil d'envoi jusqu'au délai du système.
MAIL_TIMEOUT_MS=10000

# ---------------------------------------------------------------- divers
EUREKA_URL=http://localhost:8761/eureka/
FRONTEND_URL=http://localhost:4200
# Lien inséré dans les courriels d'étape ; {resourceType} et {resourceId} y sont substitués.
WORKFLOW_LIEN_MOTIF=
