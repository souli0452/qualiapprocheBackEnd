    # Variables d'environnement des services QualiSira.
#
# Copier ce fichier en `.env` — ignoré par git — et y porter les vraies valeurs. Aucun secret ne
# doit figurer ici : ce fichier est versionné, et un mot de passe versionné est un mot de passe
# public.
#
#   cp .env.example .env

# ---------------------------------------------------------------- licence — OBLIGATOIRE
#
# Clé publique de l'éditeur, avec laquelle referentiel-service VÉRIFIE la licence de cette
# installation. Elle ne permet pas d'en signer : la porter dans la configuration d'un produit
# livré ne divulgue rien. C'est même sa raison d'être que d'y être.
#
# SANS ELLE, LE SERVICE NE DÉMARRE PAS. Une clé par défaut figurait dans application.yml — celle
# d'un poste de développement. Oubliée à la livraison, elle laissait le service démarrer puis
# refuser TOUTES les licences réelles pour « signature invalide », des jours plus tard, sans que
# rien ne relie la panne à une variable manquante.
#
# Où la relever : sur qualisira-licences, écran « Clé de vérification », ou /actuator/info (qui
# demande désormais d'être connecté). Elle doit être celle de l'instance qui a signé la licence :
# deux clés différentes, et la licence est refusée.
QUALISIRA_CLE_PUBLIQUE=

# ---------------------------------------------------------------- base de données
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL_WORKFLOW=jdbc:postgresql://localhost:5432/qualisira_workflowdb

# ---------------------------------------------------------------- Keycloak
#
# Le secret du client n'a aucune valeur par défaut dans les fichiers de configuration : un service
# qui démarre sans lui échoue avec un message explicite. L'ancien secret a figuré dans git — il est
# public : REGENEREZ-LE dans Keycloak (client quali-sira → Credentials → Regenerate) avant toute
# mise en production, puis reportez la nouvelle valeur ici.
KC_ISSUER_URI=http://localhost:8080/realms/quali
KC_CLIENT_ID=quali-sira
KC_CLIENT_SECRET=
KC_TOKEN_URI=http://localhost:8080/realms/quali/protocol/openid-connect/token

# ---------------------------------------------------------------- serveur de fichiers (MinIO)
#
# Mêmes règles : les anciens identifiants ont figuré dans git, changez-les côté MinIO avant la
# production. Utilisés par support-service et amelioration-service.
MINIO_URL=https://s3.horeb.tech
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=quali-sira

# ---------------------------------------------------------------- courriel (SMTP)
#
# Le mot de passe n'a aucune valeur par défaut dans les fichiers de configuration : un service qui
# démarre sans lui échoue avec un message explicite, au lieu de tourner en n'envoyant rien — ce qui
# est précisément ce qui s'est produit et n'a laissé aucune trace parlante.
#
# Deux façons de chiffrer, à ne jamais activer ensemble :
#   port 465 → MAIL_SSL=true  MAIL_STARTTLS=false   (SSL implicite, le défaut)
#   port 587 → MAIL_SSL=false MAIL_STARTTLS=true    (la connexion démarre en clair puis se chiffre)
MAIL_HOST=mail.qualisira.com
MAIL_PORT=465
MAIL_USERNAME=noreply@qualisira.com
MAIL_PASSWORD=
MAIL_SSL=true
MAIL_STARTTLS=false
# Délai avant d'abandonner une connexion ou un envoi, en millisecondes. Sans lui, un serveur
# injoignable retient le fil d'envoi jusqu'au délai du système.
MAIL_TIMEOUT_MS=10000

# ---------------------------------------------------------------- journaux
#
# La journalisation des requêtes SQL est coupée par défaut : chaque requête y passait avec ses
# valeurs — donc des données de dossiers dans les journaux — et le volume noyait les lignes qui
# comptent. À n'activer que pour déboguer, jamais en production.
SPRING_JPA_SHOW_SQL=false

# ---------------------------------------------------------------- divers
EUREKA_URL=http://localhost:8761/eureka/
FRONTEND_URL=http://localhost:4200
# Les liens des courriels d'étape se composent de FRONTEND_URL et d'une table de routes par type
# de ressource (workflow.notifications.liens, dans l'application.yml du workflow) : renseigner
# FRONTEND_URL suffit à rendre les boutons « Consulter » cliquables. WORKFLOW_LIEN_MOTIF ne sert
# plus que de repli pour un type absent de la table.
WORKFLOW_LIEN_MOTIF=

# ---------------------------------------------------------------- migrations de schéma
#
# Le schéma des bases n'est plus déduit des entités au démarrage : il est décrit par des scripts
# versionnés dans <service>/src/main/resources/db/migration, appliqués par Flyway.
#
#   • Une base déjà en service est marquée « v1 » au premier démarrage, sans que V1 y soit rejoué,
#     puis reçoit les migrations suivantes.
#   • Une base vide reçoit tous les scripts depuis V1.
#   • Hibernate est en « validate » : tout écart entre les entités et le schéma migré fait échouer
#     le démarrage avec le détail de l'écart, au lieu de corriger la base en silence.
#
# Pour ajouter une évolution : créer V<n+1>__ce_que_ca_fait.sql dans le service concerné, jamais
# modifier un script déjà appliqué — Flyway en vérifie l'empreinte.
#
# Repli d'urgence si un écart bloque un démarrage en production : SPRING_JPA_HIBERNATE_DDL_AUTO=none
# laisse démarrer le service sans la vérification, le temps d'écrire la migration qui manque.
